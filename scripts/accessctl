#!/usr/bin/env bash
# Local, unprivileged backend for Omarchy Access Profiles.
#
# stdout is reserved for exactly one compact JSON response. Diagnostics from
# dependencies are redirected to stderr so QML can safely parse the result.
set -u
set -o pipefail
umask 077

readonly SCHEMA_VERSION=1
readonly SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
readonly DEFAULT_PROFILES_FILE="$SCRIPT_DIR/../profiles/defaults.json"
readonly SETTING_SPECS='{"gtk.animations.enabled":{"type":"bool","scope":"GTK applications","label":"GTK animations","adapter":"gsettings","schema":"org.gnome.desktop.interface","key":"enable-animations"},"gtk.cursor.size":{"type":"int","min":16,"max":128,"scope":"GTK applications","label":"GTK cursor size","adapter":"gsettings","schema":"org.gnome.desktop.interface","key":"cursor-size"},"gtk.text.scale":{"type":"number","min":0.5,"max":3,"scope":"GTK applications","label":"GTK text scale","adapter":"gsettings","schema":"org.gnome.desktop.interface","key":"text-scaling-factor"},"hypr.animations.enabled":{"type":"bool","scope":"Hyprland session","label":"Hyprland animations","adapter":"hyprctl","option":"animations:enabled"},"hypr.blur.enabled":{"type":"bool","scope":"Hyprland session","label":"Blur","adapter":"hyprctl","option":"decoration:blur:enabled"},"hypr.border_size":{"type":"int","min":0,"max":32,"scope":"Hyprland session","label":"Window border size","adapter":"hyprctl","option":"general:border_size"},"hypr.cursor.zoom_factor":{"type":"number","min":0.5,"max":3,"scope":"Hyprland compositor","label":"Cursor zoom","adapter":"hyprctl","option":"cursor:zoom_factor"},"hypr.dim_inactive":{"type":"bool","scope":"Hyprland session","label":"Inactive-window dimming","adapter":"hyprctl","option":"decoration:dim_inactive"},"hypr.dim_strength":{"type":"number","min":0,"max":1,"scope":"Hyprland session","label":"Inactive dim strength","adapter":"hyprctl","option":"decoration:dim_strength"},"hypr.shadow.enabled":{"type":"bool","scope":"Hyprland session","label":"Window shadows","adapter":"hyprctl","option":"decoration:shadow:enabled"},"input.repeat_delay":{"type":"int","min":100,"max":2000,"scope":"Hyprland keyboard input","label":"Keyboard repeat delay","adapter":"hyprctl","option":"input:repeat_delay"},"input.repeat_rate":{"type":"int","min":1,"max":100,"scope":"Hyprland keyboard input","label":"Keyboard repeat rate","adapter":"hyprctl","option":"input:repeat_rate"}}'
MOCK_APPLY_COUNT=0
BASELINE_PREVIOUS_JSON='null'
BASELINE_CAPTURE_CHANGED=false

die() {
  printf 'accessctl: %s\n' "$*" >&2
  return 1
}

json_error() {
  local message="$1" code="${2:-1}" details="${3-}"
  [[ -n "$details" ]] || details='{}'
  jq -cn --arg message "$message" --argjson details "$details" \
    '{ok:false,schemaVersion:1,error:$message,details:$details}'
  return "$code"
}

json_ok() {
  local body="${1-}"
  [[ -n "$body" ]] || body='{}'
  jq -cn --argjson body "$body" '$body | .ok = true | .schemaVersion = 1'
}

is_absolute() { [[ "${1:-}" == /* ]]; }

has_unsafe_path_component() {
  local path="$1"
  [[ "$path" == *$'\n'* || "$path" == *$'\r'* ]] && return 0
  [[ "$path" == */../* || "$path" == ../* || "$path" == */.. || "$path" == .. ]] && return 0
  [[ "$path" == */./* || "$path" == ./* || "$path" == */. || "$path" == . ]] && return 0
  return 1
}

normalize_root() {
  local raw="$1" normalized
  is_absolute "$raw" || { die "XDG path must be absolute"; return 1; }
  has_unsafe_path_component "$raw" && { die "XDG path contains an unsafe component"; return 1; }
  normalized=$(realpath -m -s -- "$raw" 2>/dev/null) || { die "cannot resolve XDG path"; return 1; }
  is_absolute "$normalized" || { die "resolved XDG path is not absolute"; return 1; }
  printf '%s\n' "$normalized"
}

symlink_component() {
  local path="$1" current="/" part
  local -a parts=()
  IFS='/' read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -z "$part" ]] && continue
    current="${current%/}/$part"
    [[ -L "$current" ]] && return 0
  done
  return 1
}

ensure_dir() {
  local dir="$1"
  symlink_component "$dir" && { die "refusing symlink directory: $dir"; return 1; }
  mkdir -p -- "$dir" 2>/dev/null || { die "cannot create state directory"; return 1; }
  chmod 700 -- "$dir" 2>/dev/null || { die "cannot secure state directory"; return 1; }
}

safe_file() {
  local file="$1"
  is_absolute "$file" || { die "state path is not absolute"; return 1; }
  [[ ! -L "$file" ]] || { die "refusing symlink state file: $file"; return 1; }
  [[ ! -e "$file" || -f "$file" ]] || { die "refusing non-regular state file: $file"; return 1; }
  symlink_component "$(dirname -- "$file")" && { die "refusing symlink state directory"; return 1; }
  ensure_dir "$(dirname -- "$file")"
}

atomic_write() {
  local file="$1" content="$2" dir tmp
  safe_file "$file" || return 1
  dir=$(dirname -- "$file")
  tmp=$(mktemp "$dir/.accessctl.tmp.XXXXXX" 2>/dev/null) || { die "cannot create atomic state file"; return 1; }
  chmod 600 -- "$tmp" 2>/dev/null || true
  if ! printf '%s\n' "$content" > "$tmp"; then
    rm -f -- "$tmp"
    die "cannot write atomic state file"
    return 1
  fi
  if ! mv -f -- "$tmp" "$file"; then
    rm -f -- "$tmp"
    die "cannot commit atomic state file"
    return 1
  fi
  chmod 600 -- "$file" 2>/dev/null || true
}

json_file_size_ok() {
  local file="$1" size
  size=$(stat -c '%s' -- "$file" 2>/dev/null) || return 1
  [[ "$size" -le 1048576 ]]
}

remove_safe_file() {
  local file="$1"
  [[ ! -e "$file" && ! -L "$file" ]] && return 0
  safe_file "$file" || return 1
  rm -f -- "$file" 2>/dev/null || { die "cannot remove state file"; return 1; }
}

init_paths() {
  local home="${HOME:-}"
  is_absolute "$home" || { die "HOME must be absolute"; return 1; }
  CONFIG_ROOT=$(normalize_root "${ACCESSCTL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$home/.config}}") || return 1
  STATE_ROOT=$(normalize_root "${ACCESSCTL_STATE_HOME:-${XDG_STATE_HOME:-$home/.local/state}}") || return 1
  RUNTIME_ROOT=$(normalize_root "${ACCESSCTL_RUNTIME_HOME:-${XDG_RUNTIME_DIR:-/tmp}}") || return 1
  PLUGIN_STATE_DIR="$STATE_ROOT/omarchy-access-profiles"
  PLUGIN_CONFIG_DIR="$CONFIG_ROOT/omarchy-access-profiles"
  STATE_FILE="$PLUGIN_STATE_DIR/state.json"
  BASELINE_FILE="$PLUGIN_STATE_DIR/baseline.json"
  PENDING_FILE="$PLUGIN_STATE_DIR/pending.json"
  HISTORY_FILE="$PLUGIN_STATE_DIR/history.jsonl"
  USER_PROFILES_FILE="$PLUGIN_CONFIG_DIR/profiles.json"
  LOCK_FILE="$RUNTIME_ROOT/omarchy-access-profiles-$UID/accessctl.lock"
  ensure_dir "$PLUGIN_STATE_DIR" || return 1
  ensure_dir "$PLUGIN_CONFIG_DIR" || return 1
  safe_file "$STATE_FILE" || return 1
  safe_file "$BASELINE_FILE" || return 1
  safe_file "$PENDING_FILE" || return 1
  safe_file "$HISTORY_FILE" || return 1
  safe_file "$USER_PROFILES_FILE" || return 1
  safe_file "$LOCK_FILE" || return 1
}

resolve_commands() {
  HYPRCTL_BIN="${ACCESSCTL_HYPRCTL:-$(command -v hyprctl 2>/dev/null || true)}"
  GSETTINGS_BIN="${ACCESSCTL_GSETTINGS:-$(command -v gsettings 2>/dev/null || true)}"
  FLOCK_BIN="${ACCESSCTL_FLOCK:-$(command -v flock 2>/dev/null || true)}"
}

validate_profiles_json() {
  local file="$1"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  json_file_size_ok "$file" || return 1
  jq -e --argjson specs "$SETTING_SPECS" '
    type == "object" and ((keys - ["profiles","schemaVersion"]) | length == 0) and
    .schemaVersion == 1 and (.profiles | type == "array" and length >= 1 and length <= 64) and
    (([.profiles[].id] | unique | length) == (.profiles | length)) and
    all(.profiles[];
      ((keys - ["description","icon","id","name","settings"]) | length == 0) and
      (.id | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$")) and
      (.name | type == "string" and length >= 1 and length <= 80) and
      (.description | type == "string" and length <= 240) and
      ((.icon == null) or (.icon | type == "string" and length <= 64 and test("^[A-Za-z0-9_-]+$"))) and
      (.settings | type == "object" and length > 0 and length <= 12) and
      all(.settings | to_entries[];
        . as $entry |
        ($specs[$entry.key] != null) and
        (if $specs[$entry.key].type == "bool" then ($entry.value | type == "boolean")
         elif $specs[$entry.key].type == "int" then ($entry.value | type == "number" and isfinite and floor == . and . >= $specs[$entry.key].min and . <= $specs[$entry.key].max)
         else ($entry.value | type == "number" and isfinite and . >= $specs[$entry.key].min and . <= $specs[$entry.key].max)
         end)
      )
    )
  ' "$file" >/dev/null 2>&1
}

load_profiles() {
  [[ -f "$DEFAULT_PROFILES_FILE" ]] || { die "built-in profiles are missing"; return 1; }
  validate_profiles_json "$DEFAULT_PROFILES_FILE" || { die "built-in profiles failed validation"; return 1; }
  if [[ -e "$USER_PROFILES_FILE" ]]; then
    validate_profiles_json "$USER_PROFILES_FILE" || { die "user profiles failed validation"; return 1; }
    PROFILES_JSON=$(jq -c -s '
      .[0] as $built | .[1] as $user |
      if (([$built.profiles[].id] + [$user.profiles[].id]) | unique | length) != (($built.profiles + $user.profiles) | length)
      then error("duplicate profile id")
      else ([$built.profiles[] + {source:"built-in"}] + [$user.profiles[] + {source:"custom"}]) end
    ' "$DEFAULT_PROFILES_FILE" "$USER_PROFILES_FILE" 2>/dev/null) || { die "duplicate profile id"; return 1; }
  else
    PROFILES_JSON=$(jq -c '[.profiles[] + {source:"built-in"}]' "$DEFAULT_PROFILES_FILE" 2>/dev/null) || { die "cannot read profiles"; return 1; }
  fi
}

profile_json() {
  local id="$1"
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || return 1
  jq -c --arg id "$id" '[.[] | select(.id == $id)] | if length == 1 then .[0] else empty end' <<< "$PROFILES_JSON" 2>/dev/null
}

validate_operation_id() {
  [[ "${1:-}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

validate_setting_id() {
  jq -e --arg id "$1" 'has($id)' <<< "$SETTING_SPECS" >/dev/null 2>&1
}

setting_type() { jq -r --arg id "$1" '.[$id].type' <<< "$SETTING_SPECS"; }
setting_scope() { jq -r --arg id "$1" '.[$id].scope' <<< "$SETTING_SPECS"; }
setting_label() { jq -r --arg id "$1" '.[$id].label' <<< "$SETTING_SPECS"; }

value_json_from_profile() {
  jq -c --arg id "$1" '.settings[$id]' <<< "$2" 2>/dev/null
}

validate_value() {
  local id="$1" value="$2"
  jq -n -e --arg id "$id" --argjson value "$value" --argjson specs "$SETTING_SPECS" '
    ($specs[$id] != null) and
    (if $specs[$id].type == "bool" then ($value | type == "boolean")
     elif $specs[$id].type == "int" then
       (($value | type) == "number") and ($value | isfinite) and (($value | floor) == $value) and $value >= $specs[$id].min and $value <= $specs[$id].max
     else
       (($value | type) == "number") and ($value | isfinite) and $value >= $specs[$id].min and $value <= $specs[$id].max
     end)
  ' >/dev/null 2>&1
}

mock_enabled() { [[ -n "${ACCESSCTL_MOCK_DIR:-}" ]]; }

mock_path() { printf '%s/%s\n' "$ACCESSCTL_MOCK_DIR" "$1"; }

mock_unsupported() {
  local id="$1" item
  IFS=',' read -r -a items <<< "${ACCESSCTL_MOCK_UNSUPPORTED:-}"
  for item in "${items[@]}"; do [[ "$item" == "$id" ]] && return 0; done
  return 1
}

read_hypr_value() {
  local id="$1" option type raw value
  option=$(jq -r --arg id "$id" '.[$id].option' <<< "$SETTING_SPECS")
  type=$(setting_type "$id")
  raw=$("$HYPRCTL_BIN" getoption "$option" -j 2>/dev/null) || return 11
  value=$(jq -c --arg type "$type" '
    if $type == "bool" then
      if .int? != null then (if .int == 0 or .int == 1 then (.int == 1) else error("no bool") end) elif .bool? != null then .bool
      elif .str? != null and (.str == "true" or .str == "false") then .str == "true" else error("no bool") end
    elif $type == "int" then
      if .int? != null then .int elif .float? != null and (.float | floor == .) then .float | floor
      elif .str? != null then (.str | tonumber) | if floor == . then floor else error("no int") end else error("no int") end
    else
      if .float? != null then .float elif .int? != null then .int
      elif .str? != null then (.str | tonumber) else error("no number") end
    end
  ' <<< "$raw" 2>/dev/null) || return 12
  validate_value "$id" "$value" || return 12
  printf '%s\n' "$value"
}

read_gsettings_value() {
  local id="$1" schema key type raw value
  schema=$(jq -r --arg id "$id" '.[$id].schema' <<< "$SETTING_SPECS")
  key=$(jq -r --arg id "$id" '.[$id].key' <<< "$SETTING_SPECS")
  type=$(setting_type "$id")
  [[ -n "$GSETTINGS_BIN" ]] || return 11
  "$GSETTINGS_BIN" writable "$schema" "$key" 2>/dev/null | grep -qx true || return 10
  raw=$("$GSETTINGS_BIN" get "$schema" "$key" 2>/dev/null) || return 11
  raw="${raw##* }"
  if [[ "$type" == bool ]]; then
    [[ "$raw" == true || "$raw" == false ]] || return 12
    value="$raw"
  else
    value=$(jq -cn --arg raw "$raw" '$raw | tonumber' 2>/dev/null) || return 12
  fi
  validate_value "$id" "$value" || return 12
  printf '%s\n' "$value"
}

read_setting() {
  local id="$1" file value adapter
  READ_STATUS=supported
  READ_ERROR=""
  READ_VALUE=""
  validate_setting_id "$id" || { READ_STATUS=error; READ_ERROR="unknown setting"; return 1; }
  if mock_enabled; then
    mock_unsupported "$id" && { READ_STATUS=unsupported; READ_ERROR="mock capability disabled"; return 1; }
    file=$(mock_path values.json)
    [[ -f "$file" ]] || { READ_STATUS=unavailable; READ_ERROR="mock values are missing"; return 1; }
    value=$(jq -c --arg id "$id" 'if has($id) then .[$id] else error("missing value") end' "$file" 2>/dev/null) || { READ_STATUS=unavailable; READ_ERROR="mock value is missing"; return 1; }
    validate_value "$id" "$value" || { READ_STATUS=error; READ_ERROR="mock value failed validation"; return 1; }
    READ_VALUE="$value"
    printf '%s\n' "$value"
    return 0
  fi
  adapter=$(jq -r --arg id "$id" '.[$id].adapter' <<< "$SETTING_SPECS")
  if [[ "$adapter" == hyprctl ]]; then
    [[ -n "$HYPRCTL_BIN" ]] || { READ_STATUS=unavailable; READ_ERROR="hyprctl is not installed"; return 1; }
    if value=$(read_hypr_value "$id"); then READ_VALUE="$value"; else case "$?" in 10) READ_STATUS=unsupported; READ_ERROR="Hyprland option is unavailable";; 11) READ_STATUS=unavailable; READ_ERROR="Hyprland option could not be read";; *) READ_STATUS=error; READ_ERROR="Hyprland returned an unexpected value";; esac; return 1; fi
  else
    if value=$(read_gsettings_value "$id"); then READ_VALUE="$value"; else case "$?" in 10) READ_STATUS=unsupported; READ_ERROR="GTK schema key is unavailable";; 11) READ_STATUS=unavailable; READ_ERROR="GTK setting could not be read";; *) READ_STATUS=error; READ_ERROR="GTK returned an unexpected value";; esac; return 1; fi
  fi
}

format_value() {
  local id="$1" value="$2" type
  type=$(setting_type "$id")
  if [[ "$type" == bool ]]; then jq -r 'if . then "true" else "false" end' <<< "$value"; else jq -r -c '.' <<< "$value"; fi
}

hypr_lua_expression() {
  local option="$1" rendered="$2" expression="$2" i
  local -a parts
  [[ "$option" =~ ^[a-z_]+(:[a-z_]+)+$ ]] || return 1
  IFS=: read -r -a parts <<< "$option"
  for ((i=${#parts[@]} - 1; i >= 0; i--)); do
    expression="{ ${parts[$i]} = $expression }"
  done
  printf 'hl.config(%s)\n' "$expression"
}

apply_setting() {
  local id="$1" value="$2" adapter schema key option rendered response expression
  validate_value "$id" "$value" || { APPLY_ERROR="value rejected"; return 1; }
  if mock_enabled; then
    local count=$((MOCK_APPLY_COUNT + 1))
    MOCK_APPLY_COUNT=$count
    if [[ -n "${ACCESSCTL_MOCK_FAIL_AFTER:-}" && "$count" -eq "$ACCESSCTL_MOCK_FAIL_AFTER" ]]; then
      APPLY_ERROR="mock failure at apply step $count"
      return 1
    fi
    local file tmp
    file=$(mock_path values.json)
    tmp=$(mktemp "$(dirname -- "$file")/.mock-values.XXXXXX") || { APPLY_ERROR="mock write failed"; return 1; }
    if ! jq -c --arg id "$id" --argjson value "$value" '.[$id] = $value' "$file" > "$tmp" 2>/dev/null; then
      rm -f -- "$tmp"; APPLY_ERROR="mock write failed"; return 1
    fi
    mv -f -- "$tmp" "$file" || { rm -f -- "$tmp"; APPLY_ERROR="mock write failed"; return 1; }
    return 0
  fi
  adapter=$(jq -r --arg id "$id" '.[$id].adapter' <<< "$SETTING_SPECS")
  rendered=$(format_value "$id" "$value")
  if [[ "$adapter" == hyprctl ]]; then
    option=$(jq -r --arg id "$id" '.[$id].option' <<< "$SETTING_SPECS")
    if expression=$(hypr_lua_expression "$option" "$rendered") \
      && response=$("$HYPRCTL_BIN" eval "$expression" 2>/dev/null) \
      && [[ "$(printf '%s' "$response" | tr -d '\r\n')" == "ok" ]]; then
      return 0
    fi
    response=$("$HYPRCTL_BIN" keyword "$option" "$rendered" 2>/dev/null) || { APPLY_ERROR="hyprctl rejected the setting"; return 1; }
    [[ "$(printf '%s' "$response" | tr -d '\r\n')" == "ok" ]] || { APPLY_ERROR="hyprctl rejected the setting"; return 1; }
  else
    schema=$(jq -r --arg id "$id" '.[$id].schema' <<< "$SETTING_SPECS")
    key=$(jq -r --arg id "$id" '.[$id].key' <<< "$SETTING_SPECS")
    "$GSETTINGS_BIN" set "$schema" "$key" "$rendered" >/dev/null 2>&1 || { APPLY_ERROR="gsettings rejected the setting"; return 1; }
  fi
}

equal_values() {
  jq -n -e --argjson a "$1" --argjson b "$2" 'if ($a|type) == "number" and ($b|type) == "number" then (($a - $b) | fabs) < 0.0001 else $a == $b end' >/dev/null 2>&1
}

read_json_object() {
  local file="$1" default="$2"
  if [[ ! -e "$file" ]]; then printf '%s\n' "$default"; return 0; fi
  safe_file "$file" || return 1
  json_file_size_ok "$file" || { die "JSON state file is too large: $file"; return 1; }
  jq -e 'type == "object"' "$file" >/dev/null 2>&1 || { die "malformed JSON object: $file"; return 1; }
  jq -c '.' "$file"
}

validate_values_object() {
  jq -n -e --argjson values "$1" --argjson specs "$SETTING_SPECS" '
    def valid_value($spec; $value):
      if $spec.type == "bool" then ($value | type == "boolean")
      elif $spec.type == "int" then
        ($value | type == "number" and isfinite and floor == . and . >= $spec.min and . <= $spec.max)
      else
        ($value | type == "number" and isfinite and . >= $spec.min and . <= $spec.max)
      end;
    ($values | type == "object") and
    all($values | to_entries[]; ($specs[.key] != null) and valid_value($specs[.key]; .value))
  ' >/dev/null 2>&1
}

validate_state_json() {
  local state="$1" values
  jq -e '
    type == "object" and ((keys - ["activeProfile","conflicts","lastApplied","lastOperation","lastOperationId","preview","schemaVersion"]) | length == 0) and
    .schemaVersion == 1 and
    ((.activeProfile == null) or (.activeProfile | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$"))) and
    (.lastApplied | type == "object") and
    ((.lastOperationId == null) or (.lastOperationId | type == "string" and test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"))) and
    ((.lastOperation // null) == null or
      (.lastOperation as $operation |
       ($operation | type) == "object" and
       (($operation | keys) - ["action","id","profileId"] | length == 0) and
       ($operation.id | type == "string" and test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) and
       ($operation.action == "apply" or $operation.action == "preview" or $operation.action == "keep-preview" or $operation.action == "preview-revert" or $operation.action == "restore") and
       ($operation.profileId | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$")) and
       $operation.id == .lastOperationId)) and
    (.conflicts | type == "array" and length <= 12 and ((map(.id) | unique | length) == length)) and
    all(.conflicts[];
      type == "object" and
      ((keys - ["baseline","current","id","label","lastApplied"]) | length == 0) and
      (.id | type == "string") and
      (.label | type == "string") and
      has("baseline") and has("current") and has("lastApplied")) and
    ((.preview == null) or
      (.preview as $preview |
       ($preview | type) == "object" and
       (($preview | keys) - ["before","deadline","lastApplied","operationId","previousActiveProfile","previousLastApplied","profileId","startedAt"] | length == 0) and
       ($preview.operationId | type == "string" and test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) and
       ($preview.profileId | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$")) and
       ($preview.startedAt | type == "number" and isfinite and floor == . and . >= 0) and
       ($preview.deadline | type == "number" and isfinite and floor == . and . >= 0) and
       ($preview.before | type == "object") and ($preview.lastApplied | type == "object") and
       (($preview.previousActiveProfile == null) or ($preview.previousActiveProfile | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$"))) and
       ($preview.previousLastApplied | type == "object")))
  ' <<< "$state" >/dev/null 2>&1 || return 1
  values=$(jq -c '.lastApplied' <<< "$state")
  validate_values_object "$values" || return 1
  while IFS= read -r values; do validate_values_object "$values" || return 1; done < <(
    jq -c '.conflicts[] | {(.id):.baseline}, {(.id):.current}, {(.id):.lastApplied}' <<< "$state"
  )
  if jq -e '.preview != null' <<< "$state" >/dev/null 2>&1; then
    validate_values_object "$(jq -c '.preview.before' <<< "$state")" || return 1
    validate_values_object "$(jq -c '.preview.lastApplied' <<< "$state")" || return 1
    validate_values_object "$(jq -c '.preview.previousLastApplied' <<< "$state")" || return 1
    jq -e '.preview as $preview | all($preview.before | keys[]; . as $id | $preview.lastApplied | has($id))' <<< "$state" >/dev/null 2>&1 || return 1
  fi
}

validate_baseline_json() {
  local baseline="$1"
  jq -e '
    type == "object" and ((keys - ["capturedAt","hyprlandVersion","schemaVersion","values"]) | length == 0) and
    .schemaVersion == 1 and
    (.capturedAt | type == "number" and isfinite and floor == . and . >= 0) and
    (.hyprlandVersion | type == "string" and length <= 240) and
    (.values | type == "object")
  ' <<< "$baseline" >/dev/null 2>&1 || return 1
  validate_values_object "$(jq -c '.values' <<< "$baseline")"
}

validate_pending_json() {
  local pending="$1" values
  jq -e '
    . as $pending |
    type == "object" and ((keys - ["applied","baselineChanged","baselinePrevious","before","kind","operationId","phase","profileId","schemaVersion","target"]) | length == 0) and
    .schemaVersion == 1 and
    (.operationId | type == "string" and test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) and
    (.kind == "apply" or .kind == "preview" or .kind == "preview-revert" or .kind == "restore") and
    (.profileId | type == "string" and test("^[a-z0-9][a-z0-9-]{0,63}$")) and
    (.before | type == "object") and (.target | type == "object") and
    (.applied | type == "array" and all(.[]; type == "string") and (unique | length) == length) and
    all(.applied[]; (. as $id | ($pending.before | has($id)) and ($pending.target | has($id)))) and
    ((.phase // "applying") == "applying" or .phase == "applied" or .phase == "rollback-failed") and
    ((.baselineChanged // false) | type == "boolean") and
    ((.baselinePrevious // null) == null or ((.baselinePrevious | type) == "object"))
  ' <<< "$pending" >/dev/null 2>&1 || return 1
  validate_values_object "$(jq -c '.before' <<< "$pending")" || return 1
  validate_values_object "$(jq -c '.target' <<< "$pending")" || return 1
  if jq -e '(.baselineChanged // false) and .baselinePrevious != null' <<< "$pending" >/dev/null 2>&1; then
    validate_baseline_json "$(jq -c '.baselinePrevious' <<< "$pending")" || return 1
  fi
}

default_state() { jq -cn '{schemaVersion:1,activeProfile:null,lastApplied:{},preview:null,conflicts:[],lastOperationId:null,lastOperation:null}'; }

load_state() {
  STATE_JSON=$(read_json_object "$STATE_FILE" "$(default_state)") || return 1
  validate_state_json "$STATE_JSON" || { die "malformed state"; return 1; }
  if [[ -f "$BASELINE_FILE" ]]; then
    BASELINE_JSON=$(read_json_object "$BASELINE_FILE" '{}') || return 1
    validate_baseline_json "$BASELINE_JSON" || { die "malformed baseline"; return 1; }
  else
    BASELINE_JSON='null'
  fi
  if [[ "$BASELINE_JSON" == null ]]; then
    jq -e '.activeProfile == null and .preview == null and (.conflicts | length == 0) and (.lastApplied | length == 0)' <<< "$STATE_JSON" >/dev/null 2>&1 || { die "state requires a missing baseline"; return 1; }
  else
    jq -e --argjson baseline "$BASELINE_JSON" '
      . as $state |
      all($state.lastApplied | keys[]; . as $id | $baseline.values | has($id)) and
      (if $state.preview == null then true else
        all($state.preview.lastApplied | keys[]; . as $id | $baseline.values | has($id)) and
        all($state.preview.before | keys[]; . as $id | $baseline.values | has($id))
       end) and
      all($state.conflicts[];
        . as $conflict | ($baseline.values | has($conflict.id)) and
        ($baseline.values[$conflict.id] == $conflict.baseline))
    ' <<< "$STATE_JSON" >/dev/null 2>&1 || { die "state and baseline do not agree"; return 1; }
  fi
}

save_state() { atomic_write "$STATE_FILE" "$STATE_JSON"; }

append_history() {
  local event="$1" existing combined trimmed
  [[ -f "$HISTORY_FILE" ]] && existing=$(tail -c 262144 -- "$HISTORY_FILE" 2>/dev/null) || existing=""
  combined="$existing${existing:+$'\n'}$event"
  trimmed=$(printf '%s\n' "$combined" | tail -n 50 | tail -c 262144)
  atomic_write "$HISTORY_FILE" "$trimmed"
}

write_pending() { atomic_write "$PENDING_FILE" "$1"; }
clear_pending() { remove_safe_file "$PENDING_FILE"; }

classify_operation() {
  local operation="$1" action="$2" profile_id="$3"
  OPERATION_STATUS=new
  jq -e --arg op "$operation" '.lastOperationId == $op' <<< "$STATE_JSON" >/dev/null 2>&1 || return 0
  if jq -e --arg op "$operation" --arg action "$action" --arg profile "$profile_id" '
    (.lastOperation // null) == null or
    (.lastOperation.id == $op and .lastOperation.action == $action and .lastOperation.profileId == $profile)
  ' <<< "$STATE_JSON" >/dev/null 2>&1; then
    OPERATION_STATUS=replay
  else
    OPERATION_STATUS=reused
  fi
}

hyprland_version() {
  if mock_enabled; then printf 'mock-hyprland\n'; return; fi
  [[ -n "$HYPRCTL_BIN" ]] || { printf 'unavailable\n'; return; }
  "$HYPRCTL_BIN" version 2>/dev/null | head -n 1 | tr -d '\r' || printf 'unavailable\n'
}

capture_baseline() {
  local source="${1:-}" values id value
  local -a ids=()
  [[ -n "$source" ]] || { die "baseline source is required"; return 1; }
  jq -e 'type == "object"' <<< "$source" >/dev/null 2>&1 || { die "baseline source is malformed"; return 1; }
  BASELINE_PREVIOUS_JSON="$BASELINE_JSON"
  BASELINE_CAPTURE_CHANGED=false
  if [[ "$BASELINE_JSON" == null ]]; then
    values='{}'
    BASELINE_JSON=$(jq -cn --arg version "$(hyprland_version)" \
      '{schemaVersion:1,capturedAt:(now|floor),hyprlandVersion:$version,values:{}}')
  else
    values=$(jq -c '.values' <<< "$BASELINE_JSON")
  fi
  mapfile -t ids < <(jq -r 'keys[]' <<< "$source")
  for id in "${ids[@]}"; do
    jq -e --arg id "$id" 'has($id)' <<< "$values" >/dev/null 2>&1 && continue
    value=$(jq -c --arg id "$id" '.[$id]' <<< "$source")
    values=$(jq -c --arg id "$id" --argjson value "$value" '.[$id] = $value' <<< "$values")
  done
  BASELINE_JSON=$(jq -c --argjson values "$values" '.values=$values' <<< "$BASELINE_JSON")
  if [[ "$BASELINE_JSON" != "$BASELINE_PREVIOUS_JSON" ]]; then
    BASELINE_CAPTURE_CHANGED=true
  fi
}

persist_baseline_capture() {
  [[ "$BASELINE_CAPTURE_CHANGED" == true ]] || return 0
  atomic_write "$BASELINE_FILE" "$BASELINE_JSON"
}

rollback_baseline_capture() {
  [[ "$BASELINE_CAPTURE_CHANGED" == true ]] || return 0
  if [[ "$BASELINE_PREVIOUS_JSON" == null ]]; then
    remove_safe_file "$BASELINE_FILE" || return 1
    BASELINE_JSON=null
  else
    atomic_write "$BASELINE_FILE" "$BASELINE_PREVIOUS_JSON" || return 1
    BASELINE_JSON="$BASELINE_PREVIOUS_JSON"
  fi
  BASELINE_CAPTURE_CHANGED=false
}

commit_baseline_capture() {
  BASELINE_PREVIOUS_JSON='null'
  BASELINE_CAPTURE_CHANGED=false
}

requested_ids() { jq -r '.settings | keys[]' <<< "$1"; }

target_for_profile() {
  local profile="$1" supported="$2" target='{}' id value
  local -a ids=()
  mapfile -t ids < <(requested_ids "$profile")
  for id in "${ids[@]}"; do
    jq -e --arg id "$id" 'has($id)' <<< "$supported" >/dev/null 2>&1 || continue
    value=$(value_json_from_profile "$id" "$profile")
    target=$(jq -c --arg id "$id" --argjson value "$value" '.[$id]=$value' <<< "$target")
  done
  printf '%s\n' "$target"
}

build_plan() {
  local profile="$1" changes='[]' warnings='[]' id target current status reason
  local -a ids=()
  mapfile -t ids < <(requested_ids "$profile")
  for id in "${ids[@]}"; do
    target=$(value_json_from_profile "$id" "$profile")
    if read_setting "$id" >/dev/null; then
      current="$READ_VALUE"
      if equal_values "$current" "$target"; then status=unchanged; else status=ready; fi
      reason=""
    else
      status="$READ_STATUS"; reason="$READ_ERROR"; current=null
      warnings=$(jq -c --arg id "$id" --arg reason "$reason" '. + [{id:$id,reason:$reason}]' <<< "$warnings")
    fi
    changes=$(jq -c --arg id "$id" --arg label "$(setting_label "$id")" --arg scope "$(setting_scope "$id")" \
      --arg status "$status" --arg reason "$reason" --argjson from "$current" --argjson to "$target" \
      '. + [{id:$id,label:$label,scope:$scope,from:$from,to:$to,status:$status,reason:$reason}]' <<< "$changes")
  done
  jq -cn --argjson changes "$changes" --argjson warnings "$warnings" --arg profile "$(jq -r '.id' <<< "$profile")" \
    '{changes:$changes,warnings:$warnings,profileId:$profile}'
}

capabilities_json() {
  local caps='[]' id value status reason current
  local -a ids=()
  mapfile -t ids < <(jq -r 'keys[]' <<< "$SETTING_SPECS")
  for id in "${ids[@]}"; do
    if read_setting "$id" >/dev/null; then current="$READ_VALUE"; status=supported; reason=""; else status="$READ_STATUS"; reason="$READ_ERROR"; current=null; fi
    caps=$(jq -c --arg id "$id" --arg label "$(setting_label "$id")" --arg scope "$(setting_scope "$id")" \
      --arg status "$status" --arg reason "$reason" --argjson current "$current" \
      '. + [{id:$id,label:$label,scope:$scope,status:$status,current:$current,reason:$reason}]' <<< "$caps")
  done
  printf '%s\n' "$caps"
}

rollback_applied() {
  local before="$1" applied="$2" rid rvalue
  ROLLBACK_OK=true
  while IFS= read -r rid; do
    rvalue=$(jq -c --arg id "$rid" '.[$id]' <<< "$before")
    apply_setting "$rid" "$rvalue" || ROLLBACK_OK=false
  done < <(jq -r 'reverse[]' <<< "$applied")
}

apply_snapshot_transaction() {
  local before="$1" target="$2" operation="$3" kind="$4" profile_id="$5" applied='[]' next_applied id value current
  local -a ids=()
  local pending
  pending=$(jq -cn --arg op "$operation" --arg kind "$kind" --arg profile "$profile_id" \
    --argjson before "$before" --argjson target "$target" --argjson baselinePrevious "$BASELINE_PREVIOUS_JSON" \
    --argjson baselineChanged "$BASELINE_CAPTURE_CHANGED" \
    '{schemaVersion:1,operationId:$op,kind:$kind,profileId:$profile,before:$before,target:$target,applied:[],phase:"applying",baselineChanged:$baselineChanged,baselinePrevious:$baselinePrevious}')
  write_pending "$pending" || return 1
  if ! persist_baseline_capture; then
    clear_pending || true
    TX_ERROR="could not persist baseline"
    return 1
  fi
  mapfile -t ids < <(jq -r 'keys[]' <<< "$target")
  for id in "${ids[@]}"; do
    value=$(jq -c --arg id "$id" '.[$id]' <<< "$target")
    next_applied=$(jq -c --arg id "$id" '. + [$id]' <<< "$applied")
    pending=$(jq -c --argjson applied "$next_applied" '.applied = $applied' <<< "$pending")
    if ! write_pending "$pending"; then
      rollback_applied "$before" "$applied"
      rollback_baseline_capture || ROLLBACK_OK=false
      [[ "$ROLLBACK_OK" == true ]] && clear_pending || true
      TX_ERROR="could not update pending journal"
      return 1
    fi
    applied="$next_applied"
    apply_setting "$id" "$value" || {
      rollback_applied "$before" "$applied"
      rollback_baseline_capture || ROLLBACK_OK=false
      if [[ "$ROLLBACK_OK" == true ]]; then clear_pending; else write_pending "$(jq -c '.phase="rollback-failed"' <<< "$pending")"; fi
      TX_ERROR="apply failed for $id: $APPLY_ERROR"
      [[ "$ROLLBACK_OK" == true ]] && TX_ERROR="$TX_ERROR; rollback verified"
      return 1
    }
    read_setting "$id" >/dev/null || {
      rollback_applied "$before" "$applied"
      rollback_baseline_capture || ROLLBACK_OK=false
      if [[ "$ROLLBACK_OK" == true ]]; then clear_pending; else write_pending "$(jq -c '.phase="rollback-failed"' <<< "$pending")"; fi
      TX_ERROR="could not read back $id"
      [[ "$ROLLBACK_OK" == true ]] && TX_ERROR="$TX_ERROR; rollback verified"
      return 1
    }
    current="$READ_VALUE"
    if ! equal_values "$current" "$value"; then
      rollback_applied "$before" "$applied"
      rollback_baseline_capture || ROLLBACK_OK=false
      if [[ "$ROLLBACK_OK" == true ]]; then clear_pending; else write_pending "$(jq -c '.phase="rollback-failed"' <<< "$pending")"; fi
      TX_ERROR="read-back verification failed for $id"
      [[ "$ROLLBACK_OK" == true ]] && TX_ERROR="$TX_ERROR; rollback verified"
      return 1
    fi
  done
  pending=$(jq -c '.phase="applied"' <<< "$pending")
  if ! write_pending "$pending"; then
    rollback_applied "$before" "$applied"
    rollback_baseline_capture || ROLLBACK_OK=false
    [[ "$ROLLBACK_OK" == true ]] && clear_pending || true
    TX_ERROR="could not finalize pending journal"
    return 1
  fi
  TX_APPLIED="$applied"
  return 0
}

abort_snapshot_transaction() {
  local before="$1" applied="$2"
  rollback_applied "$before" "$applied"
  rollback_baseline_capture || ROLLBACK_OK=false
  if [[ "$ROLLBACK_OK" == true ]]; then clear_pending || ROLLBACK_OK=false; fi
}

commit_snapshot_transaction() {
  commit_baseline_capture
  clear_pending
}

snapshot_for_profile() {
  local profile="$1" snapshot='{}' id value
  local -a ids=()
  mapfile -t ids < <(requested_ids "$profile")
  for id in "${ids[@]}"; do
    read_setting "$id" >/dev/null || {
      [[ "$READ_STATUS" == unsupported || "$READ_STATUS" == unavailable ]] && continue
      SNAPSHOT_ERROR="$READ_ERROR"
      return 1
    }
    value="$READ_VALUE"
    snapshot=$(jq -c --arg id "$id" --argjson value "$value" '.[$id] = $value' <<< "$snapshot")
  done
  printf '%s\n' "$snapshot"
}

complete_restore() {
  local operation="$1"
  RESTORE_STATE_COMMITTED=false
  STATE_JSON=$(jq -c --arg op "$operation" '.activeProfile = null | .lastApplied = {} | .preview = null | .conflicts = [] | .lastOperationId = $op | .lastOperation={id:$op,action:"restore",profileId:"restore"}' <<< "$STATE_JSON")
  save_state || return 1
  RESTORE_STATE_COMMITTED=true
  remove_safe_file "$BASELINE_FILE" || return 1
  BASELINE_JSON=null
  append_history "$(jq -cn --arg op "$operation" '{at:(now|floor),operationId:$op,action:"restore",result:"ok"}')" || true
}

revert_preview() {
  local preview="$1" operation="$2" restore='{}' restore_before='{}' drift='[]' id original expected current
  local -a ids=()
  mapfile -t ids < <(jq -r '.before | keys[]' <<< "$preview")
  for id in "${ids[@]}"; do
    original=$(jq -c --arg id "$id" '.before[$id]' <<< "$preview")
    expected=$(jq -c --arg id "$id" '.lastApplied[$id]' <<< "$preview")
    read_setting "$id" >/dev/null || { PREVIEW_REVERT_ERROR="could not read $id: $READ_ERROR"; return 1; }
    current="$READ_VALUE"
    if equal_values "$current" "$expected"; then
      restore=$(jq -c --arg id "$id" --argjson value "$original" '.[$id]=$value' <<< "$restore")
      restore_before=$(jq -c --arg id "$id" --argjson value "$current" '.[$id]=$value' <<< "$restore_before")
    elif ! equal_values "$current" "$original"; then
      drift=$(jq -c --arg id "$id" '. + [$id]' <<< "$drift")
    fi
  done
  apply_snapshot_transaction "$restore_before" "$restore" "$operation" preview-revert "$(jq -r '.profileId' <<< "$preview")" || {
    PREVIEW_REVERT_ERROR="${TX_ERROR:-preview rollback failed}"
    return 1
  }
  STATE_JSON=$(jq -c --arg op "$operation" --argjson drift "$drift" '
    .preview as $preview |
    .activeProfile=(if ($drift | length) == 0 then $preview.previousActiveProfile else null end) |
    .lastApplied=($preview.previousLastApplied | with_entries(.key as $id | select($drift | index($id) | not))) |
    .preview=null | .lastOperationId=$op | .lastOperation={id:$op,action:"preview-revert",profileId:$preview.profileId}
  ' <<< "$STATE_JSON")
  if ! save_state; then
    abort_snapshot_transaction "$restore_before" "$TX_APPLIED"
    PREVIEW_REVERT_ERROR="$([[ "$ROLLBACK_OK" == true ]] && echo "preview state persistence failed; rollback reverted" || echo "preview state persistence failed; recovery is required")"
    return 1
  fi
  commit_snapshot_transaction || { PREVIEW_REVERT_ERROR="preview reverted but journal cleanup is pending"; return 1; }
  PREVIEW_REVERT_DRIFT="$drift"
  PREVIEW_REVERT_CHANGES="$restore"
}

recover_expired_preview() {
  local preview deadline now operation
  RECOVERED_PREVIEW=false
  preview=$(jq -c '.preview // empty' <<< "$STATE_JSON")
  [[ -n "$preview" ]] || return 0
  deadline=$(jq -r '.deadline // 0' <<< "$preview")
  now=$(date +%s)
  [[ "$deadline" =~ ^[0-9]+$ && "$deadline" -le "$now" ]] || return 0
  operation=$(jq -r '.operationId' <<< "$preview")
  revert_preview "$preview" "$operation" || return 1
  append_history "$(jq -cn --argjson drift "$PREVIEW_REVERT_DRIFT" '{at:(now|floor),action:"recover-preview",result:"ok",preservedExternal:$drift}')" || true
  RECOVERED_PREVIEW=true
}

cmd_capabilities() {
  local capabilities version body
  capabilities=$(capabilities_json)
  version=$(hyprland_version)
  body=$(jq -cn --argjson capabilities "$capabilities" --arg version "$version" '{capabilities:$capabilities,hyprlandVersion:$version}')
  json_ok "$body"
}

cmd_list_profiles() { jq -cn --argjson profiles "$PROFILES_JSON" '{ok:true,schemaVersion:1,profiles:$profiles}'; }

cmd_save_profile() {
  local raw="$1" profile existing='{"schemaVersion":1,"profiles":[]}' candidate id
  profile=$(jq -c 'if type == "object" then {id,name,description,icon,settings} else empty end' <<< "$raw" 2>/dev/null) || { json_error "custom profile is invalid" 2; return; }
  [[ -n "$profile" ]] || { json_error "custom profile is invalid" 2; return; }
  id=$(jq -r '.id // ""' <<< "$profile")
  jq -e --arg id "$id" 'all(.profiles[]; .id != $id)' "$DEFAULT_PROFILES_FILE" >/dev/null 2>&1 || { json_error "built-in profiles cannot be replaced" 2; return; }
  if [[ -f "$USER_PROFILES_FILE" ]]; then existing=$(jq -c . "$USER_PROFILES_FILE" 2>/dev/null) || { json_error "user profiles are malformed" 2; return; }; fi
  candidate=$(jq -c --argjson profile "$profile" --arg id "$id" '.profiles = ([.profiles[] | select(.id != $id)] + [$profile])' <<< "$existing")
  local check_file; check_file=$(mktemp "$PLUGIN_CONFIG_DIR/.profiles-check.XXXXXX") || { json_error "cannot validate custom profile" 2; return; }
  printf '%s\n' "$candidate" > "$check_file"
  if ! validate_profiles_json "$check_file"; then rm -f -- "$check_file"; json_error "custom profile is invalid" 2; return; fi
  rm -f -- "$check_file"
  atomic_write "$USER_PROFILES_FILE" "$candidate" || { json_error "could not save custom profile" 2; return; }
  json_ok "$(jq -cn --arg id "$id" '{profileId:$id,saved:true}')"
}

cmd_delete_profile() {
  local id="$1" existing candidate
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || { json_error "custom profile id is invalid" 2; return; }
  [[ -f "$USER_PROFILES_FILE" ]] || { json_error "custom profile not found" 2; return; }
  jq -e --arg id "$id" 'any(.profiles[]; .id == $id)' "$USER_PROFILES_FILE" >/dev/null 2>&1 || { json_error "custom profile not found" 2; return; }
  jq -e --arg id "$id" '.activeProfile != $id and (.preview == null or .preview.profileId != $id)' <<< "$STATE_JSON" >/dev/null || { json_error "active profiles cannot be deleted" 2; return; }
  existing=$(jq -c . "$USER_PROFILES_FILE")
  candidate=$(jq -c --arg id "$id" '.profiles |= map(select(.id != $id))' <<< "$existing")
  if [[ "$(jq '.profiles | length' <<< "$candidate")" == 0 ]]; then
    remove_safe_file "$USER_PROFILES_FILE" || { json_error "could not delete custom profile" 2; return; }
  else
    atomic_write "$USER_PROFILES_FILE" "$candidate" || { json_error "could not delete custom profile" 2; return; }
  fi
  json_ok "$(jq -cn --arg id "$id" '{profileId:$id,deleted:true}')"
}

cmd_status() {
  local caps values='{}' id value
  local -a ids=()
  recover_expired_preview || { json_error "expired preview rollback failed" 2; return; }
  caps=$(capabilities_json)
  mapfile -t ids < <(jq -r 'keys[]' <<< "$SETTING_SPECS")
  for id in "${ids[@]}"; do
    read_setting "$id" >/dev/null || continue
    value="$READ_VALUE"
    values=$(jq -c --arg id "$id" --argjson value "$value" '.[$id]=$value' <<< "$values")
  done
  jq -cn --argjson state "$STATE_JSON" --argjson caps "$caps" --argjson values "$values" --arg baseline "$([[ "$BASELINE_JSON" == null ]] && echo false || echo true)" \
    '{ok:true,schemaVersion:1,activeProfile:$state.activeProfile,preview:$state.preview,conflicts:($state.conflicts // []),baselineCaptured:($baseline == "true"),values:$values,capabilities:$caps}'
}

cmd_plan() {
  local profile
  profile=$(profile_json "$1") || { json_error "unknown profile" 2; return; }
  [[ -n "$profile" ]] || { json_error "unknown profile" 2; return; }
  local plan; plan=$(build_plan "$profile")
  json_ok "$plan"
}

cmd_apply() {
  local profile_id="$1" operation="$2" profile before target
  profile=$(profile_json "$profile_id") || { json_error "unknown profile" 2; return; }
  [[ -n "$profile" ]] || { json_error "unknown profile" 2; return; }
  validate_operation_id "$operation" || { json_error "invalid operation id" 2; return; }
  classify_operation "$operation" apply "$profile_id"
  [[ "$OPERATION_STATUS" != replay ]] || { json_ok "$(jq -cn --arg op "$operation" --arg profile "$profile_id" '{operationId:$op,profileId:$profile,idempotent:true}')"; return; }
  [[ "$OPERATION_STATUS" != reused ]] || { json_error "operation-id-reused" 2; return; }
  jq -e '.preview == null' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "preview-active" 2; return; }
  jq -e '.conflicts | length == 0' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "external-drift-pending" 2; return; }
  before=$(snapshot_for_profile "$profile") || { json_error "could not read current values" 2 "$(jq -cn --arg reason "${SNAPSHOT_ERROR:-$READ_ERROR}" '{reason:$reason}')"; return; }
  target=$(target_for_profile "$profile" "$before")
  [[ "$target" != '{}' ]] || { json_error "no supported settings are available for this profile" 2; return; }
  capture_baseline "$before" || { json_error "could not capture baseline" 2; return; }
  if ! apply_snapshot_transaction "$before" "$target" "$operation" apply "$profile_id"; then
    rollback_baseline_capture || true
    json_error "${TX_ERROR:-apply failed}" 2
    return
  fi
  STATE_JSON=$(jq -c --arg profile "$profile_id" --arg op "$operation" --argjson applied "$TX_APPLIED" \
    --argjson target "$target" '.activeProfile=$profile | .lastApplied = ((.lastApplied // {}) + $target) | .preview=null | .conflicts=[] | .lastOperationId=$op | .lastOperation={id:$op,action:"apply",profileId:$profile}' <<< "$STATE_JSON")
  if ! save_state; then
    abort_snapshot_transaction "$before" "$TX_APPLIED"
    json_error "$([[ "$ROLLBACK_OK" == true ]] && echo "state persistence failed; settings rolled back" || echo "state persistence failed; recovery is required")" 2
    return
  fi
  commit_snapshot_transaction || { json_error "settings committed but journal cleanup is pending" 2; return; }
  append_history "$(jq -cn --arg op "$operation" --arg profile "$profile_id" '{at:(now|floor),operationId:$op,action:"apply",profileId:$profile,result:"ok"}')" || true
  json_ok "$(jq -cn --arg op "$operation" --arg profile "$profile_id" --argjson changes "$target" '{operationId:$op,profileId:$profile,changes:$changes}')"
}

cmd_preview() {
  local profile_id="$1" seconds="$2" operation="$3" profile before target deadline
  [[ "$seconds" =~ ^[1-9][0-9]{0,3}$ && "$seconds" -le 3600 ]] || { json_error "preview duration must be 1-3600 seconds" 2; return; }
  profile=$(profile_json "$profile_id") || { json_error "unknown profile" 2; return; }
  [[ -n "$profile" ]] || { json_error "unknown profile" 2; return; }
  validate_operation_id "$operation" || { json_error "invalid operation id" 2; return; }
  classify_operation "$operation" preview "$profile_id"
  [[ "$OPERATION_STATUS" != replay ]] || { json_ok "$(jq -cn --arg op "$operation" '{operationId:$op,idempotent:true}')"; return; }
  [[ "$OPERATION_STATUS" != reused ]] || { json_error "operation-id-reused" 2; return; }
  jq -e '.preview == null' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "preview-active" 2; return; }
  jq -e '.conflicts | length == 0' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "external-drift-pending" 2; return; }
  before=$(snapshot_for_profile "$profile") || { json_error "could not read current values" 2; return; }
  target=$(target_for_profile "$profile" "$before")
  [[ "$target" != '{}' ]] || { json_error "no supported settings are available for this profile" 2; return; }
  capture_baseline "$before" || { json_error "could not capture baseline" 2; return; }
  deadline=$(( $(date +%s) + seconds ))
  if ! apply_snapshot_transaction "$before" "$target" "$operation" preview "$profile_id"; then
    rollback_baseline_capture || true
    json_error "${TX_ERROR:-preview failed}" 2
    return
  fi
  STATE_JSON=$(jq -c --arg profile "$profile_id" --arg op "$operation" --argjson before "$before" --argjson target "$target" --argjson deadline "$deadline" \
    '.preview={operationId:$op,profileId:$profile,startedAt:(now|floor),deadline:$deadline,before:$before,lastApplied:((.lastApplied // {}) + $target),previousActiveProfile:.activeProfile,previousLastApplied:.lastApplied} | .lastOperationId=$op | .lastOperation={id:$op,action:"preview",profileId:$profile}' <<< "$STATE_JSON")
  if ! save_state; then
    abort_snapshot_transaction "$before" "$TX_APPLIED"
    json_error "$([[ "$ROLLBACK_OK" == true ]] && echo "preview persistence failed; settings rolled back" || echo "preview persistence failed; recovery is required")" 2
    return
  fi
  commit_snapshot_transaction || { json_error "preview committed but journal cleanup is pending" 2; return; }
  json_ok "$(jq -cn --arg op "$operation" --arg profile "$profile_id" --argjson deadline "$deadline" --argjson changes "$target" '{operationId:$op,profileId:$profile,deadline:$deadline,changes:$changes}')"
}

cmd_keep_preview() {
  local operation="$1" preview drift='[]' id expected current
  local -a ids=()
  validate_operation_id "$operation" || { json_error "invalid operation id" 2; return; }
  preview=$(jq -c '.preview // empty' <<< "$STATE_JSON")
  [[ -n "$preview" ]] || { json_error "no active preview" 2; return; }
  jq -e --arg op "$operation" '.operationId == $op' <<< "$preview" >/dev/null 2>&1 || { json_error "operation id does not match preview" 2; return; }
  mapfile -t ids < <(jq -r '.before | keys[]' <<< "$preview")
  for id in "${ids[@]}"; do
    expected=$(jq -c --arg id "$id" '.lastApplied[$id]' <<< "$preview")
    read_setting "$id" >/dev/null || { json_error "could not verify preview before keeping it" 2 "$(jq -cn --arg id "$id" --arg reason "$READ_ERROR" '{id:$id,reason:$reason}')"; return; }
    current="$READ_VALUE"
    equal_values "$current" "$expected" || drift=$(jq -c --arg id "$id" '. + [$id]' <<< "$drift")
  done
  STATE_JSON=$(jq -c --arg op "$operation" --argjson drift "$drift" '
    .preview as $preview |
    .activeProfile=(if ($drift | length) == 0 then $preview.profileId else null end) |
    .lastApplied=($preview.lastApplied | with_entries(.key as $id | select($drift | index($id) | not))) |
    .preview=null | .conflicts=[] | .lastOperationId=$op |
    .lastOperation={id:$op,action:"keep-preview",profileId:$preview.profileId}
  ' <<< "$STATE_JSON")
  save_state || { json_error "could not persist kept preview" 2; return; }
  append_history "$(jq -cn --arg op "$operation" --argjson drift "$drift" '{at:(now|floor),operationId:$op,action:"keep-preview",result:"ok",preservedExternal:$drift}')" || true
  json_ok "$(jq -cn --arg op "$operation" --argjson drift "$drift" '{operationId:$op,preview:null,preservedExternal:$drift}')"
}

cmd_cancel_preview() {
  local operation="$1" preview
  validate_operation_id "$operation" || { json_error "invalid operation id" 2; return; }
  preview=$(jq -c '.preview // empty' <<< "$STATE_JSON")
  [[ -n "$preview" ]] || { json_error "no active preview" 2; return; }
  jq -e --arg op "$operation" '.operationId == $op' <<< "$preview" >/dev/null 2>&1 || { json_error "operation id does not match preview" 2; return; }
  revert_preview "$preview" "$operation" || { json_error "${PREVIEW_REVERT_ERROR:-preview rollback failed}" 2; return; }
  append_history "$(jq -cn --arg op "$operation" --argjson drift "$PREVIEW_REVERT_DRIFT" '{at:(now|floor),operationId:$op,action:"cancel-preview",result:"ok",preservedExternal:$drift}')" || true
  json_ok "$(jq -cn --arg op "$operation" --argjson drift "$PREVIEW_REVERT_DRIFT" --argjson changes "$PREVIEW_REVERT_CHANGES" '{operationId:$op,preview:null,preservedExternal:$drift,changes:$changes}')"
}

cmd_restore() {
  local operation="$1" conflicts='[]' restore='{}' restore_before='{}' id baseline current last
  local -a ids=()
  validate_operation_id "$operation" || { json_error "invalid operation id" 2; return; }
  jq -e '.preview == null' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "preview-active" 2; return; }
  jq -e '.conflicts | length == 0' <<< "$STATE_JSON" >/dev/null 2>&1 || { json_error "external-drift-pending" 2; return; }
  [[ "$BASELINE_JSON" != null ]] || { json_ok "$(jq -cn '{message:"No Access baseline is stored."}')"; return; }
  mapfile -t ids < <(jq -r '.values | keys[]' <<< "$BASELINE_JSON")
  for id in "${ids[@]}"; do
    baseline=$(jq -c --arg id "$id" '.values[$id]' <<< "$BASELINE_JSON")
    last=$(jq -c --arg id "$id" 'if (.lastApplied | has($id)) then .lastApplied[$id] else null end' <<< "$STATE_JSON")
    [[ "$last" != null ]] || continue
    read_setting "$id" >/dev/null || { json_error "cannot read managed setting" 2 "$(jq -cn --arg id "$id" --arg reason "$READ_ERROR" '{id:$id,reason:$reason}')"; return; }
    current="$READ_VALUE"
    if equal_values "$current" "$last"; then
      restore=$(jq -c --arg id "$id" --argjson value "$baseline" '.[$id]=$value' <<< "$restore")
      restore_before=$(jq -c --arg id "$id" --argjson value "$current" '.[$id]=$value' <<< "$restore_before")
    elif equal_values "$current" "$baseline"; then
      :
    else
      conflicts=$(jq -c --arg id "$id" --argjson baseline "$baseline" --argjson current "$current" --argjson last "$last" \
        '. + [{id:$id,baseline:$baseline,current:$current,lastApplied:$last,label:""}]' <<< "$conflicts")
    fi
  done
  conflicts=$(jq -c --argjson specs "$SETTING_SPECS" 'map(.label = $specs[.id].label)' <<< "$conflicts")
  apply_snapshot_transaction "$restore_before" "$restore" "$operation" restore "$(jq -r '.activeProfile // "restore"' <<< "$STATE_JSON")" || {
    json_error "${TX_ERROR:-restore failed}" 2
    return
  }
  if [[ "$conflicts" != '[]' ]]; then
    STATE_JSON=$(jq -c --argjson conflicts "$conflicts" --arg op "$operation" '
      .activeProfile=null | .preview=null | .conflicts=$conflicts | .lastOperationId=$op | .lastOperation={id:$op,action:"restore",profileId:"restore"} |
      .lastApplied = (.lastApplied | with_entries(.key as $id | select(any($conflicts[]; .id == $id))))
    ' <<< "$STATE_JSON")
    if ! save_state; then
      abort_snapshot_transaction "$restore_before" "$TX_APPLIED"
      json_error "$([[ "$ROLLBACK_OK" == true ]] && echo "could not persist external drift state; safe restores rolled back" || echo "could not persist external drift state; recovery is required")" 2
      return
    fi
    commit_snapshot_transaction || { json_error "external drift saved but journal cleanup is pending" 2; return; }
    json_error "external-drift" 2 "$(jq -cn --argjson conflicts "$conflicts" --argjson restored "$restore" '{conflicts:$conflicts,restored:$restored}')"
    return
  fi
  if ! complete_restore "$operation"; then
    if [[ "$RESTORE_STATE_COMMITTED" != true ]]; then abort_snapshot_transaction "$restore_before" "$TX_APPLIED"; fi
    json_error "settings restored but state cleanup failed" 2
    return
  fi
  commit_snapshot_transaction || { json_error "settings restored but journal cleanup is pending" 2; return; }
  json_ok "$(jq -cn --arg op "$operation" --argjson changes "$restore" '{operationId:$op,changes:$changes,activeProfile:null}')"
}

cmd_resolve_conflict() {
  local id="$1" mode="$2" conflict target current recorded
  validate_setting_id "$id" || { json_error "unknown setting" 2; return; }
  conflict=$(jq -c --arg id "$id" '[.conflicts[]? | select(.id == $id)] | if length == 1 then .[0] else empty end' <<< "$STATE_JSON")
  [[ -n "$conflict" ]] || { json_error "conflict not found" 2; return; }
  if [[ "$mode" == keep ]]; then
    STATE_JSON=$(jq -c --arg id "$id" 'del(.lastApplied[$id]) | .conflicts |= map(select(.id != $id))' <<< "$STATE_JSON")
  else
    target=$(jq -c '.baseline' <<< "$conflict")
    recorded=$(jq -c '.current' <<< "$conflict")
    read_setting "$id" >/dev/null || { json_error "conflict setting could not be read" 2; return; }
    current="$READ_VALUE"
    if ! equal_values "$current" "$target"; then
      if ! equal_values "$current" "$recorded"; then
        STATE_JSON=$(jq -c --arg id "$id" --argjson current "$current" '(.conflicts[] | select(.id == $id) | .current) = $current' <<< "$STATE_JSON")
        save_state || { json_error "external drift changed again and could not be recorded" 2; return; }
        json_error "external-drift-changed" 2 "$(jq -cn --arg id "$id" --argjson current "$current" '{id:$id,current:$current}')"
        return
      fi
      apply_setting "$id" "$target" || { json_error "conflict restore failed" 2; return; }
      read_setting "$id" >/dev/null || { json_error "conflict restore read-back failed" 2; return; }
      current="$READ_VALUE"
      equal_values "$current" "$target" || { json_error "conflict restore verification failed" 2; return; }
    fi
    STATE_JSON=$(jq -c --arg id "$id" 'del(.lastApplied[$id]) | del(.conflicts[] | select(.id == $id))' <<< "$STATE_JSON")
  fi
  if [[ "$(jq '.conflicts | length' <<< "$STATE_JSON")" == 0 ]]; then
    complete_restore "$(jq -r '.lastOperationId // "00000000-0000-0000-0000-000000000000"' <<< "$STATE_JSON")" || { json_error "state cleanup failed" 2; return; }
  else
    save_state || { json_error "could not persist conflict resolution" 2; return; }
  fi
  json_ok "$(jq -cn --arg id "$id" --arg resolution "$mode" '{settingId:$id,resolution:$resolution}')"
}

cmd_recover() {
  local pending before applied operation kind previous
  if [[ -f "$PENDING_FILE" ]]; then
    pending=$(read_json_object "$PENDING_FILE" '{}') || { json_error "pending journal is malformed" 2; return; }
    validate_pending_json "$pending" || { json_error "pending journal is malformed" 2; return; }
    operation=$(jq -r '.operationId' <<< "$pending")
    kind=$(jq -r '.kind' <<< "$pending")
    if jq -e --arg op "$operation" --arg kind "$kind" --arg profile "$(jq -r '.profileId' <<< "$pending")" '
      .lastOperationId == $op and
      (if $kind == "apply" then .activeProfile == $profile and .preview == null
       elif $kind == "preview" then .preview.operationId == $op
       elif $kind == "preview-revert" then .preview == null
       else .activeProfile == null and .preview == null
       end)
    ' <<< "$STATE_JSON" >/dev/null 2>&1; then
      if [[ "$kind" == restore ]] && jq -e '.conflicts | length == 0' <<< "$STATE_JSON" >/dev/null 2>&1; then
        remove_safe_file "$BASELINE_FILE" || { json_error "restore committed but baseline cleanup failed" 2; return; }
        BASELINE_JSON=null
      fi
      clear_pending || { json_error "committed operation journal cleanup failed" 2; return; }
    else
      before=$(jq -c '.before' <<< "$pending")
      applied=$(jq -c '.applied' <<< "$pending")
      rollback_applied "$before" "$applied"
      [[ "$ROLLBACK_OK" == true ]] || { json_error "recovery rollback failed" 2; return; }
      if jq -e '.baselineChanged // false' <<< "$pending" >/dev/null 2>&1; then
        previous=$(jq -c '.baselinePrevious // null' <<< "$pending")
        if [[ "$previous" == null ]]; then
          remove_safe_file "$BASELINE_FILE" || { json_error "recovery baseline cleanup failed" 2; return; }
          BASELINE_JSON=null
        else
          atomic_write "$BASELINE_FILE" "$previous" || { json_error "recovery baseline rollback failed" 2; return; }
          BASELINE_JSON="$previous"
        fi
      fi
      clear_pending || { json_error "recovered settings but journal cleanup failed" 2; return; }
    fi
  fi
  recover_expired_preview || { json_error "expired preview rollback failed" 2; return; }
  if [[ "$RECOVERED_PREVIEW" == true ]]; then json_ok '{"recoveredPreview":true}'; else json_ok '{"recovered":false}'; fi
}

cmd_export_diagnostics() {
  local caps
  caps=$(capabilities_json)
  jq -cn --argjson caps "$caps" --arg active "$(jq -r '.activeProfile // ""' <<< "$STATE_JSON")" \
    --argjson baseline "$(jq -cn --argjson value "$([[ "$BASELINE_JSON" == null ]] && echo false || echo true)" '$value')" \
    '{ok:true,schemaVersion:1,pluginVersion:"1.1.0",activeProfile:$active,baselineParsed:$baseline,capabilities:$caps,notes:["No usernames, home paths, window titles, command history, or application content are included."]}'
}

main() {
  local command="${1:-}"; shift || true
  init_paths || { json_error "unsafe or unavailable state paths" 2; return; }
  resolve_commands
  load_profiles || { json_error "profile data is invalid" 2; return; }
  load_state || { json_error "state is malformed; no mutation was performed" 2; return; }
  case "$command" in
    capabilities) cmd_capabilities ;;
    status) cmd_status ;;
    list-profiles) cmd_list_profiles ;;
    save-profile) if [[ $# -eq 1 ]]; then cmd_save_profile "$1"; else json_error "usage: save-profile <json>" 2; fi ;;
    delete-profile) if [[ $# -eq 1 ]]; then cmd_delete_profile "$1"; else json_error "usage: delete-profile <profile-id>" 2; fi ;;
    plan) if [[ $# -eq 1 ]]; then cmd_plan "$1"; else json_error "usage: plan <profile-id>" 2; fi ;;
    apply) if [[ $# -eq 3 && "$2" == --operation-id ]]; then cmd_apply "$1" "$3"; else json_error "usage: apply <profile-id> --operation-id <uuid>" 2; fi ;;
    preview) if [[ $# -eq 5 && "$2" == --seconds && "$4" == --operation-id ]]; then cmd_preview "$1" "$3" "$5"; else json_error "usage: preview <profile-id> --seconds <n> --operation-id <uuid>" 2; fi ;;
    keep-preview) if [[ $# -eq 2 && "$1" == --operation-id ]]; then cmd_keep_preview "$2"; else json_error "usage: keep-preview --operation-id <uuid>" 2; fi ;;
    cancel-preview) if [[ $# -eq 2 && "$1" == --operation-id ]]; then cmd_cancel_preview "$2"; else json_error "usage: cancel-preview --operation-id <uuid>" 2; fi ;;
    restore) if [[ $# -eq 2 && "$1" == --operation-id ]]; then cmd_restore "$2"; else json_error "usage: restore --operation-id <uuid>" 2; fi ;;
    resolve-conflict) if [[ $# -eq 2 && "$2" == --keep-external ]]; then cmd_resolve_conflict "$1" keep; elif [[ $# -eq 2 && "$2" == --restore-baseline ]]; then cmd_resolve_conflict "$1" restore; else json_error "usage: resolve-conflict <setting-id> --keep-external|--restore-baseline" 2; fi ;;
    recover) if [[ $# -eq 0 ]]; then cmd_recover; else json_error "usage: recover" 2; fi ;;
    export-diagnostics) if [[ $# -eq 0 ]]; then cmd_export_diagnostics; else json_error "usage: export-diagnostics" 2; fi ;;
    *) json_error "unknown command" 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # A short lock keeps duplicate monitor widgets from mutating settings at
  # the same time. Read-only calls still take the same lock so their plans do
  # not race a concurrent apply.
  if ! init_paths 2>/dev/null; then json_error "unsafe or unavailable state paths" 2; exit 2; fi
  resolve_commands
  if [[ -z "$FLOCK_BIN" ]]; then json_error "flock is unavailable" 2; exit 2; fi
  exec 9>"$LOCK_FILE" || { json_error "cannot open state lock" 2; exit 2; }
  if ! "$FLOCK_BIN" -w 2 9; then json_error "another Access operation is in progress" 2; exit 2; fi
  main "$@"
fi
